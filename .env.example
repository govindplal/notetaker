# Copy to .env (git-ignored). Every setting is optional; the defaults work.
# No keys are needed here: notes use your signed-in Claude Code, and transcription runs locally.

# Where the database, work files, notes and the recorder Chrome profile live.
NOTETAKER_DATA_DIR=data

# The recorder Chrome's remote-debugging address, and the browser to launch for sign-in
# (set NOTETAKER_CHROME if Chrome is not in its usual place).
NOTETAKER_CDP_URL=http://127.0.0.1:9222
# NOTETAKER_CHROME=

# Playback speed while recording. Audio is slowed back to normal pace before transcription.
NOTETAKER_SPEED=2.0

# Testing only: cap each lecture at this many seconds of lecture time.
# NOTETAKER_MAX_MEDIA_S=150

# Speech to text (faster-whisper). Leave the language unset to auto-detect; forcing the wrong
# language produces gibberish, so try a short clip first. The prompt is an optional vocabulary hint.
NOTETAKER_WHISPER_MODEL=large-v3-turbo
# NOTETAKER_WHISPER_LANGUAGE=en
# NOTETAKER_WHISPER_PROMPT=

# Notes: model for `claude -p` (default is your account's), and your own note style
# (a Markdown file replacing src/notetaker/notes/style.md).
# NOTETAKER_CLAUDE_MODEL=
# NOTETAKER_STYLE_FILE=

# Page detection for sites worded differently. Comma-separated, case-insensitive; each replaces
# the built-in defaults.
# NOTETAKER_SIGNIN_URL_HINTS=/login,/signin
# NOTETAKER_SIGNIN_TEXT_HINTS=sign in to continue
# NOTETAKER_BUSY_TEXT=video already playing
